<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <!-- Windows 10 1809 et au-delà : les API média et notifications y sont présentes. -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DynamicIsland</AssemblyName>
    <RootNamespace>DynamicIsland</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>DynamicIsland.Program</StartupObject>
    <!-- L'interface est construite en C# : pas de XAML, donc pas de App.xaml. -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
